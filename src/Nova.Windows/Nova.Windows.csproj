<Project Sdk="Microsoft.NET.Sdk">
  <!-- Win32 / Windows Shell integration: IExplorerBrowser hosting, IFileOperation, hotkeys, AppBar, foreground events. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Nova.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Classic [ComImport] interop is intentional (stable, well-understood for Shell interfaces). -->
    <NoWarn>$(NoWarn);SYSLIB1096;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nova.Core\Nova.Core.csproj" />
  </ItemGroup>
</Project>
