<Window x:Class="Nova.App.Views.WorkspaceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workspace settings" Width="720" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="12.5"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Done" IsDefault="True" IsCancel="True" MinWidth="90" Click="OnDone" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Style="{StaticResource CompactTextBox}" Margin="0,3"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Color" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox Width="100" Style="{StaticResource CompactTextBox}" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" />
                        <ItemsControl x:Name="Swatches" Margin="8,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="22" Height="22" Margin="2,0" Click="OnSwatch" Tag="{Binding}" Cursor="Hand"
                                            Background="{Binding Converter={StaticResource HexToBrush}}" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="11" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Description" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource CompactTextBox}" Margin="0,3"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Text="Path variables" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,2" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"
                           Text="Name a root once (e.g. COMFY = D:\ComfyUI) and pins under it are stored as ${COMFY}\…  Move the folder or import this workspace on another PC, change one value, and every pin follows." />
                <DataGrid x:Name="VariablesGrid" ItemsSource="{Binding Variables}" AutoGenerateColumns="False" CanUserAddRows="True"
                          CanUserDeleteRows="True" HeadersVisibility="Column" MinHeight="90" MaxHeight="200" RowHeight="28">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
                        <DataGridTextColumn Header="Value (path)" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Automatic detection" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,2" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"
                           Text="This workspace activates when the foreground app matches a rule. Process is the executable name (wildcards allowed, .exe optional) — not its install path, so rules survive updates. Title is optional: plain text matches anywhere, * and ? are wildcards, re: starts a regular expression." />
                <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules}" AutoGenerateColumns="False" CanUserAddRows="True"
                          CanUserDeleteRows="True" HeadersVisibility="Column" MinHeight="90" MaxHeight="220" RowHeight="28">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="44" />
                        <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="150" />
                        <DataGridTextColumn Header="Window title (optional)" Binding="{Binding TitlePattern}" Width="*" />
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="AddFromLast" Click="OnAddFromLast" Padding="10,3" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
