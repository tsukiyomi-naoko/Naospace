<Window x:Class="Nova.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA settings" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="12.5"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Show / hide NOVA" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Style="{StaticResource CompactTextBox}" Margin="0,3" Text="{Binding ToggleHotkey}"
                     ToolTip="e.g. Ctrl+Alt+Space, Win+Shift+N. Opens NOVA with the jump palette ready." />
            <TextBlock Grid.Row="1" Text="Capture Explorer folder" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactTextBox}" Margin="0,3" Text="{Binding CaptureHotkey}"
                     ToolTip="While a File Explorer window is active, adds its folder to the current working set." />
            <TextBlock Grid.Row="2" Text="Workspace detection" VerticalAlignment="Center" />
            <ComboBox x:Name="DetectionBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource CompactComboBox}" Margin="0,3"
                      SelectedItem="{Binding DetectionMode}" />
            <TextBlock Grid.Row="3" Text="Theme" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource CompactComboBox}" Margin="0,3"
                      SelectedItem="{Binding Theme}" />
            <TextBlock Grid.Row="4" Text="Docking" VerticalAlignment="Center" />
            <ComboBox x:Name="DockBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource CompactComboBox}" Margin="0,3"
                      SelectedItem="{Binding Dock}"
                      ToolTip="Left/Right registers NOVA as a desktop toolbar: Windows reserves the screen edge for it." />
            <TextBlock Grid.Row="5" Text="Recent folders kept" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" Width="80" HorizontalAlignment="Left" Style="{StaticResource CompactTextBox}" Margin="0,3"
                     Text="{Binding MaxRecents}" />
        </Grid>
        <CheckBox Content="Show hidden and system files" IsChecked="{Binding ShowHiddenFiles}" Margin="0,10,0,0" />
        <CheckBox Content="Hide NOVA when it loses focus (overlay style)" IsChecked="{Binding HideOnFocusLoss}" Margin="0,6,0,0" />
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Detection: Off ignores the active app. Suggest shows a one-click “Switch to …” chip. Automatic switches for you unless the workspace is locked." />
        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Done" IsDefault="True" IsCancel="True" MinWidth="90" Click="OnDone" />
            <Button DockPanel.Dock="Left" Content="Open data folder" Click="OnOpenData" Padding="10,3" HorizontalAlignment="Left"
                    ToolTip="state.json and rolling backups live here" />
        </DockPanel>
    </StackPanel>
</Window>
