<Window x:Class="Nova.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nova.App.ViewModels"
        xmlns:m="clr-namespace:Nova.Core.Models;assembly=Nova.Core"
        xmlns:v="clr-namespace:Nova.App.Views"
        Title="{Binding WindowTitle}"
        Icon="/Assets/nova.ico"
        Width="1180" Height="720" MinWidth="240" MinHeight="320"
        FontSize="12.5"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Pin tree templates -->
        <HierarchicalDataTemplate DataType="{x:Type m:PinGroup}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Background="Transparent">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D5;" FontSize="12" Opacity="0.75" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type m:PinItem}">
            <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding Target}">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Kind, Converter={StaticResource PinGlyph}}"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{x:Static v:MainWindow.QuickJumpCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═════════ Top bar: context (workspace · session) and window modes ═════════ -->
        <!-- Laid out in one row when expanded and two rows in compact mode (see MainWindow.ApplyLayout). -->
        <Grid Grid.Row="0" Margin="6,4,6,4" x:Name="TopBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel x:Name="WorkspaceGroup" Width="230" Margin="0,0,8,0">
                <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="4,0,6,0" VerticalAlignment="Center"
                        Background="{Binding ActiveWorkspace.Color, Converter={StaticResource HexToBrush}}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Workspace actions"
                        Click="OnWorkspaceMenu" Margin="2,0,0,0" />
                <ComboBox x:Name="WorkspaceBox" Style="{StaticResource CompactComboBox}"
                          ItemsSource="{Binding Workspaces}" SelectedItem="{Binding ActiveWorkspace, Mode=TwoWay}"
                          ToolTip="Workspace (Ctrl+1…9)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <DockPanel x:Name="SessionGroup" Grid.Column="1" Width="190" Margin="0,0,8,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Session actions"
                        Click="OnSessionMenu" Margin="2,0,0,0" />
                <ComboBox x:Name="SessionBox" Style="{StaticResource CompactComboBox}"
                          ItemsSource="{Binding ActiveWorkspace.Sessions}" SelectedItem="{Binding ActiveSession, Mode=TwoWay}"
                          DisplayMemberPath="Name" ToolTip="Session — a saved set of tabs and working locations" />
            </DockPanel>

            <!-- Detection chip (Suggest mode): one click to follow the foreground app. -->
            <Button x:Name="DetectChip" Grid.Column="2" HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                    Command="{Binding AcceptDetectedCommand}"
                    Visibility="{Binding DetectedWorkspace, Converter={StaticResource NullToVis}}"
                    ToolTip="The active application matches this workspace. Click to switch.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEA80;" FontSize="11" Margin="0,0,5,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding DetectedWorkspace.Name, StringFormat='Switch to {0}'}" />
                </StackPanel>
            </Button>

            <StackPanel x:Name="ToolButtons" Grid.Column="3" Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Click="OnQuickJump" Margin="0,0,4,0"
                        ToolTip="Jump to any pin, folder, session or workspace (Ctrl+K)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="11" />
                        <TextBlock x:Name="JumpLabel" Text="  Jump  " />
                        <TextBlock x:Name="JumpHint" Text="Ctrl+K" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Button>
                <ToggleButton Style="{StaticResource IconButton}" Content="&#xE89F;"
                              IsChecked="{Binding IsDualPane}" ToolTip="Dual pane (Ctrl+\)"
                              Visibility="{Binding IsCompact, Converter={StaticResource InvBoolToVis}}" />
                <ToggleButton Style="{StaticResource IconButton}" Content="&#xE72E;"
                              IsChecked="{Binding IsLocked}" ToolTip="Lock workspace (automatic detection won't switch away)" />
                <ToggleButton Style="{StaticResource IconButton}" Content="&#xE718;"
                              IsChecked="{Binding IsTopmost}" ToolTip="Always on top" />
                <ToggleButton Style="{StaticResource IconButton}" Content="&#xE73F;"
                              IsChecked="{Binding IsCompact}" ToolTip="Compact sidebar (Ctrl+B)" />
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="OnSettings" />
            </StackPanel>
        </Grid>

        <!-- ═════════ Body: sidebar + browser ═════════ -->
        <Grid Grid.Row="1" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="200" />
                <ColumnDefinition x:Name="SplitterColumn" Width="4" />
                <ColumnDefinition x:Name="BrowserColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,1,0">
                <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" Padding="0,4,0,8">
                    <StackPanel>
                        <!-- Learned-rule suggestion -->
                        <Border Margin="8,4,8,6" Padding="8" CornerRadius="6"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding Suggestion, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SuggestionText}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Right">
                                    <Button Content="Not now" Style="{StaticResource FlatButton}" Command="{Binding DismissSuggestionCommand}" />
                                    <Button Content="Remember" Margin="6,0,0,0" Padding="10,2" Command="{Binding AcceptSuggestionCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- PINNED -->
                        <DockPanel Margin="0,2,4,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE710;"
                                    ToolTip="Add pin, group or tool" Click="OnAddPinMenu" />
                            <TextBlock Text="PINNED" Style="{StaticResource SectionHeader}" />
                        </DockPanel>
                        <TreeView x:Name="PinTree" ItemsSource="{Binding ActiveWorkspace.Pins}" BorderThickness="0" Background="Transparent"
                                  Margin="2,2,2,6" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnNestedMouseWheel"
                                  MouseDoubleClick="OnPinDoubleClick" PreviewMouseUp="OnPinMouseUp" KeyDown="OnPinKeyDown"
                                  ContextMenuOpening="OnPinContextMenuOpening"
                                  PreviewMouseLeftButtonDown="OnPinMouseDown" MouseMove="OnPinMouseMove"
                                  DragOver="OnPinDragOver" Drop="OnPinDrop">
                            <TreeView.ContextMenu><ContextMenu /></TreeView.ContextMenu>
                        </TreeView>
                        <TextBlock x:Name="PinHint" Margin="12,0,12,8" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Drag folders here from NOVA or Explorer to pin them. Drop files onto a pinned folder to move them there.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveWorkspace.Pins.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- WORKING SET -->
                        <DockPanel Margin="0,4,4,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                                    ToolTip="Clear working set" Command="{Binding ClearWorkingSetCommand}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE710;"
                                    ToolTip="Add current folder to working set (Ctrl+Shift+D)" Command="{Binding AddCurrentToWorkingSetCommand}" />
                            <TextBlock Text="WORKING SET" Style="{StaticResource SectionHeader}"
                                       ToolTip="Folders you're using for this session's task. Not permanent — promote them to pins if they stick." />
                        </DockPanel>
                        <ListBox x:Name="WorkingList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding ActiveSession.WorkingSet}" BorderThickness="0" Background="Transparent"
                                 Margin="2,2,2,6" AllowDrop="True" PreviewMouseWheel="OnNestedMouseWheel"
                                 MouseDoubleClick="OnLocationDoubleClick" PreviewMouseUp="OnLocationMouseUp" KeyDown="OnLocationKeyDown"
                                 DragOver="OnWorkingSetDragOver" Drop="OnWorkingSetDrop">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:WorkingLocation}">
                                    <DockPanel ToolTip="{Binding Path}" Background="Transparent">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" Margin="0,0,6,0" Opacity="0.8" />
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ParentPath}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Click="OnLocationOpen" />
                                    <MenuItem Header="Open in new tab" Click="OnLocationOpenNewTab" />
                                    <MenuItem Header="Open in File Explorer" Click="OnLocationOpenExplorer" />
                                    <Separator />
                                    <MenuItem Header="Rename label…" Click="OnWorkingRename" />
                                    <MenuItem Header="Promote to permanent pin" Click="OnWorkingPromote" />
                                    <MenuItem Header="Remove from working set" Click="OnWorkingRemove" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <!-- RECENT -->
                        <DockPanel Margin="0,4,4,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                                    ToolTip="Clear recent folders for this workspace" Command="{Binding ClearRecentsCommand}" />
                            <TextBlock Text="RECENT" Style="{StaticResource SectionHeader}" ToolTip="Folders visited in this workspace" />
                        </DockPanel>
                        <ListBox x:Name="RecentList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding ActiveWorkspace.Recents}" BorderThickness="0" Background="Transparent"
                                 Margin="2,2,2,6" MaxHeight="360" PreviewMouseWheel="OnNestedMouseWheel"
                                 MouseDoubleClick="OnLocationDoubleClick" PreviewMouseUp="OnLocationMouseUp" KeyDown="OnLocationKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:RecentEntry}">
                                    <DockPanel ToolTip="{Binding Path}" Background="Transparent">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" Margin="0,0,6,0" Opacity="0.6" />
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ParentPath}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Click="OnLocationOpen" />
                                    <MenuItem Header="Open in new tab" Click="OnLocationOpenNewTab" />
                                    <MenuItem Header="Open in File Explorer" Click="OnLocationOpenExplorer" />
                                    <Separator />
                                    <MenuItem Header="Pin to workspace" Click="OnRecentPin" />
                                    <MenuItem Header="Add to working set" Click="OnRecentToWorkingSet" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <!-- NOTES -->
                        <Expander Margin="4,4,4,0" Padding="0">
                            <Expander.Header>
                                <TextBlock Text="SESSION NOTES" Style="{StaticResource SectionHeader}" Margin="0" />
                            </Expander.Header>
                            <TextBox Text="{Binding ActiveSession.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="80" Margin="4" VerticalContentAlignment="Top" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"
                          DragCompleted="OnSidebarResized" />

            <!-- Browser panes -->
            <Grid x:Name="BrowserHost" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PaneSplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="RightPaneColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <v:BrowserPaneView x:Name="LeftPaneView" Grid.Column="0" DataContext="{Binding LeftPane}" />
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <v:BrowserPaneView x:Name="RightPaneView" Grid.Column="2" DataContext="{Binding RightPane}" />
            </Grid>
        </Grid>

        <!-- ═════════ Status bar ═════════ -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding ActivePane.SelectedTab.StatusText}" />
                <TextBlock DockPanel.Dock="Right" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ActivePane.SelectedTab.SelectionText}" />
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>

        <!-- ═════════ Quick jump overlay (Ctrl+K) ═════════ -->
        <Grid x:Name="QuickJumpOverlay" Grid.RowSpan="3" Background="#66000000" Visibility="Collapsed"
              MouseDown="OnOverlayMouseDown">
            <Border Width="560" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                    VerticalAlignment="Top" Margin="12,56,12,12" Padding="8" CornerRadius="8"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    MouseDown="OnOverlayPanelMouseDown">
                <DockPanel>
                    <TextBox x:Name="QuickJumpBox" DockPanel.Dock="Top" Style="{StaticResource CompactTextBox}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnQuickJumpKey" />
                    <TextBlock DockPanel.Dock="Bottom" Margin="4,6,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Enter open · Ctrl+Enter new tab · Esc close · type or paste a path to go there" />
                    <ListBox x:Name="QuickJumpList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" MaxHeight="420"
                             Margin="0,6,0,0" BorderThickness="0" Background="Transparent" MouseUp="OnQuickJumpClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
