<UserControl x:Class="Nova.App.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <DockPanel>
        <Border x:Name="TabStripBorder" DockPanel.Dock="Top" Background="{DynamicResource Nova.PanelAlt}"
                BorderBrush="{DynamicResource Nova.Border}" BorderThickness="0,2,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Nova.IconButton}" Content="&#xE710;"
                        ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab" Click="OnNewTabClick"/>
                <ListBox x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource Nova.TabItem}" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Tabs"
                         PreviewMouseDown="OnTabStripPreviewMouseDown" ContextMenuOpening="OnTabContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu/>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding ToolTip}" Background="Transparent">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Nova.IconButton}" Content="&#xE711;"
                                        FontSize="9" MinWidth="18" MinHeight="18" Padding="3" Margin="4,0,0,0"
                                        ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab"
                                        Tag="{Binding}" Click="OnCloseTabClick"/>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid x:Name="HostGrid" Background="{DynamicResource Nova.Panel}">
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="16" Foreground="{DynamicResource Nova.ForegroundMuted}"
                       Text="No open tabs.&#x0a;Click a pinned folder or press Ctrl+T."/>
        </Grid>
    </DockPanel>
</UserControl>
