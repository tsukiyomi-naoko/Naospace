<UserControl x:Class="Nova.App.Views.BrowserPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nova.App.ViewModels"
             PreviewGotKeyboardFocus="OnAnyFocus" PreviewMouseDown="OnAnyMouseDown">
    <Border x:Name="Frame" BorderThickness="0,2,0,0" BorderBrush="Transparent">
        <DockPanel>
            <!-- Tab strip -->
            <DockPanel DockPanel.Dock="Top" Margin="4,4,4,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE710;" ToolTip="New tab (Ctrl+T)"
                        Command="{Binding NewTabCommand}" VerticalAlignment="Center" />
                <ListBox x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         PreviewMouseUp="OnTabMouseUp" AllowDrop="True" DragOver="OnTabDragOver" Drop="OnTabDrop">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}" MaxWidth="200">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="11" Margin="0,0,6,0" Opacity="0.75" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="150" />
                                <Button Style="{StaticResource SmallIconButton}" Content="&#xE711;" Width="18" Height="18" FontSize="9" Margin="6,0,0,0"
                                        ToolTip="Close tab (Ctrl+W)"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Duplicate tab" Click="OnDuplicateTab" />
                            <MenuItem Header="Close tab" Click="OnCloseTab" />
                            <MenuItem Header="Close other tabs" Click="OnCloseOtherTabs" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>

            <!-- Navigation bar -->
            <DockPanel DockPanel.Dock="Top" Margin="4,4,4,4" DataContext="{Binding SelectedTab}">
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back (Alt+Left)"
                        IsEnabled="{Binding CanGoBack}" Click="OnBack" />
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward (Alt+Right)"
                        IsEnabled="{Binding CanGoForward}" Click="OnForward" />
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Up (Alt+Up)"
                        IsEnabled="{Binding CanGoUp}" Click="OnUp" />
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh (F5)" Click="OnRefresh" Margin="0,0,4,0" />

                <Grid DockPanel.Dock="Right" Width="150" Margin="6,0,0,0">
                    <TextBox x:Name="FilterBox" Style="{StaticResource CompactTextBox}"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             ToolTip="Filter this folder (Ctrl+F). Text, wildcards (*.png) or re:regex"
                             PreviewKeyDown="OnFilterKey" />
                    <TextBlock Text="Filter  (Ctrl+F)" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding FilterText, Converter={StaticResource NullToCollapsed}}" />
                </Grid>

                <!-- Address: breadcrumbs, click empty space (or Ctrl+L) to type a path -->
                <Grid>
                    <Border x:Name="CrumbBar" CornerRadius="4" MinHeight="28" Padding="2,0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            MouseLeftButtonUp="OnCrumbBarClick" Cursor="IBeam"
                            Visibility="{Binding IsEditingAddress, Converter={StaticResource InvBoolToVis}}">
                        <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Center" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center" Cursor="Arrow" HorizontalAlignment="Left"
                                      SizeChanged="OnCrumbsSizeChanged">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:Crumb}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource FlatButton}" Content="{Binding Label}" Click="OnCrumbClick"
                                                ToolTip="{Binding Path}" AllowDrop="True" DragOver="OnCrumbDragOver" Drop="OnCrumbDrop" />
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="8" Opacity="0.5" Margin="1,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBox x:Name="AddressBox" Style="{StaticResource CompactTextBox}" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditingAddress, Converter={StaticResource BoolToVis}}"
                             PreviewKeyDown="OnAddressKey" LostKeyboardFocus="OnAddressLostFocus" />
                </Grid>
            </DockPanel>

            <!-- File list -->
            <Grid>
                <ListView x:Name="FileList" ItemsSource="{Binding SelectedTab.Items}" SelectionMode="Extended" BorderThickness="0"
                          Background="Transparent" AllowDrop="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.IsDeferredScrollingEnabled="False"
                          MouseDoubleClick="OnItemDoubleClick" PreviewKeyDown="OnListKey" ContextMenuOpening="OnListContextMenu"
                          PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseLeftButtonUp="OnListMouseUp" MouseMove="OnListMouseMove"
                          PreviewMouseUp="OnListMiddleClick" DragOver="OnListDragOver" Drop="OnListDrop"
                          GridViewColumnHeader.Click="OnHeaderClick" SelectionChanged="OnSelectionChanged"
                          ItemContainerStyle="{StaticResource FileRowStyle}">
                    <ListView.ContextMenu><ContextMenu /></ListView.ContextMenu>
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn Width="320">
                                <GridViewColumn.Header><GridViewColumnHeader x:Name="NameHeader" Tag="Name" Content="Name" /></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                        <StackPanel Orientation="Horizontal" Opacity="{Binding Opacity}">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="140" DisplayMemberBinding="{Binding ModifiedText}">
                                <GridViewColumn.Header><GridViewColumnHeader x:Name="ModifiedHeader" Tag="Modified" Content="Date modified" /></GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="140" DisplayMemberBinding="{Binding TypeName}">
                                <GridViewColumn.Header><GridViewColumnHeader x:Name="TypeHeader" Tag="Type" Content="Type" /></GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="90">
                                <GridViewColumn.Header><GridViewColumnHeader x:Name="SizeHeader" Tag="Size" Content="Size" /></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Text="{Binding SelectedTab.Error}" Visibility="{Binding SelectedTab.Error, Converter={StaticResource NullToVis}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top" BorderThickness="0"
                             Visibility="{Binding SelectedTab.IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
