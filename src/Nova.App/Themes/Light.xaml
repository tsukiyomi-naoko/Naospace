<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- NOVA palette (light). Standard controls use the WPF Fluent theme; these brushes style NOVA's own surfaces. -->
    <SolidColorBrush x:Key="Nova.Background" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Nova.Panel" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="Nova.PanelAlt" Color="#EDEDED"/>
    <SolidColorBrush x:Key="Nova.Border" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="Nova.Foreground" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Nova.ForegroundMuted" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="Nova.Accent" Color="#005FB8"/>
    <SolidColorBrush x:Key="Nova.AccentForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Nova.Hover" Color="#E3E3E3"/>
    <SolidColorBrush x:Key="Nova.Pressed" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Nova.Selected" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="Nova.Error" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Nova.Warning" Color="#9D5D00"/>
    <SolidColorBrush x:Key="Nova.InfoBar" Color="#E8F1FB"/>
</ResourceDictionary>
