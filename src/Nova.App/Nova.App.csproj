<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the app compile on non-Windows CI/dev machines. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Nova.App</RootNamespace>
    <AssemblyName>NovaWorkspace</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nova.ico</ApplicationIcon>
    <!-- WPF0001: ThemeMode (Fluent) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avoid WinForms/WPF type-name clashes (Application, MessageBox, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\nova.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nova.Core\Nova.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
</Project>
