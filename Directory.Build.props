<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Allows the Windows projects to be compiled (not run) on non-Windows CI/dev machines. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.1.0</Version>
    <Company>NOVA Workspace</Company>
    <Product>NOVA Workspace</Product>
    <Copyright>Copyright (c) 2026 NOVA Workspace contributors</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
